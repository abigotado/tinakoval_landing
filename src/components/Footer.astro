---
import { footer, person } from '../content/ru';

interface Props {
  /** Leave room for the phone booking bar (AC-DOCK-1). */
  withDock?: boolean;
}

const { withDock = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class:list={['footer', { 'footer-dock': withDock }]}>
  <div class="container footer-inner">
    <div class="footer-notes">
      <p>{footer.disclaimer}</p>
    </div>
    <div class="footer-meta">
      <a href={`${base}privacy/`}>{footer.policy}</a>
      <p>
        © {year} {person.name}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 3rem;
    padding-block: 2rem 2.5rem;
  }

  .footer-notes {
    display: flex;
    flex: 1 1 32.5rem;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 46em;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .footer-meta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  @media (width < 53.75em), (orientation: landscape) and (height <= 31.25em) {
    .footer-inner {
      flex-direction: column;
      padding-block: 1.75rem;
    }

    .footer-notes {
      flex-basis: auto;
    }

    .footer-dock .footer-inner {
      padding-bottom: calc(1.75rem + var(--dock-h));
    }
  }

  @media (height < 20em) {
    .footer-dock .footer-inner {
      padding-bottom: 1.75rem;
    }
  }
</style>
