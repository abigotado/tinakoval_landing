---
import { thread } from '../content/ru';

// «Клубок распутывается» (AC-THREAD-1): loops that fade into a straight line.
// The path is computed at build time; CSS draws it once on load.
const W = 1200;
const H = 90;
const POINTS = 480;

function threadPath(turns: number, stretch: number): string {
  let d = '';
  // After t = 0.78 the loops have faded out; one straight segment ends it.
  for (let i = 0; i <= POINTS * 0.78; i++) {
    const t = i / POINTS;
    const fade = Math.pow(Math.max(0, 1 - t / 0.78), 1.6);
    const r = 34 * fade;
    const a = t * Math.PI * 2 * turns;
    const x = 6 + t * (W - 12) + r * stretch * Math.cos(a);
    const y = H / 2 + r * Math.sin(a) + 6 * fade * Math.sin(t * 37);
    d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return `${d}L${W - 6} ${H / 2}`;
}

const desktop = threadPath(15, 1.15);
const phone = threadPath(9, 1.6);
---

<div class="container thread" aria-hidden="true">
  <svg
    class="thread-wide"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    focusable="false"
  >
    <path d={desktop}></path>
  </svg>
  <svg
    class="thread-narrow"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    focusable="false"
  >
    <path d={phone}></path>
  </svg>
  <div class="thread-labels">
    <span>{thread.from}</span>
    <span>{thread.to}</span>
  </div>
</div>

<style>
  .thread {
    padding-top: 1.5rem;
  }

  svg {
    width: 100%;
    height: 5.625rem;
    overflow: visible;
  }

  path {
    fill: none;
    stroke: var(--plum);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* Revealed once, from the tangle to the straight line (§5.3, AC-THREAD-2).
     A clip, not stroke-dashoffset: the stroke is non-scaling, so dash lengths
     would be measured on screen and not along the path. */
  @media (prefers-reduced-motion: no-preference) {
    svg {
      animation: thread-reveal 2.8s cubic-bezier(0.45, 0, 0.25, 1) 0.4s both;
    }
  }

  @keyframes thread-reveal {
    from {
      clip-path: inset(-50% 110% -50% -10%);
    }

    to {
      clip-path: inset(-50% -10% -50% -10%);
    }
  }

  .thread-narrow {
    display: none;
  }

  .thread-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 0.375rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 53.6875em),
    (orientation: landscape) and (max-height: 31.25em) {
    .thread {
      padding-top: 1.25rem;
    }

    .thread-wide {
      display: none;
    }

    .thread-narrow {
      display: block;
      height: 3.5rem;
    }

    .thread-narrow path {
      stroke-width: 2.2;
    }

    .thread-labels {
      font-size: 0.6875rem;
    }
  }
</style>
