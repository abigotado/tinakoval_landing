---
import { thread } from '../content/ru';

// «Клубок распутывается» (AC-THREAD-1): loops that fade into a straight line.
// The path is computed at build time; the page ships a static SVG.
const W = 1200;
const H = 90;
const POINTS = 480;

function threadPath(turns: number, stretch: number): string {
  let d = '';
  // After t = 0.78 the loops have faded out; one straight segment ends it.
  for (let i = 0; i <= POINTS * 0.78; i++) {
    const t = i / POINTS;
    const fade = Math.pow(Math.max(0, 1 - t / 0.78), 1.6);
    const r = 34 * fade;
    const a = t * Math.PI * 2 * turns;
    const x = 6 + t * (W - 12) + r * stretch * Math.cos(a);
    const y = H / 2 + r * Math.sin(a) + 6 * fade * Math.sin(t * 37);
    d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return `${d}L${W - 6} ${H / 2}`;
}

const desktop = threadPath(15, 1.15);
const phone = threadPath(9, 1.6);
---

<div class="container thread" aria-hidden="true">
  <svg
    class="thread-wide"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    focusable="false"
  >
    <path d={desktop}></path>
  </svg>
  <svg
    class="thread-narrow"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    focusable="false"
  >
    <path d={phone}></path>
  </svg>
  <div class="thread-labels">
    <span>{thread.from}</span>
    <span>{thread.to}</span>
  </div>
</div>

<style>
  .thread {
    padding-top: 24px;
  }

  svg {
    width: 100%;
    height: 90px;
    overflow: visible;
  }

  path {
    fill: none;
    stroke: var(--plum);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .thread-narrow {
    display: none;
  }

  .thread-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 859px) {
    .thread {
      padding-top: 20px;
    }

    .thread-wide {
      display: none;
    }

    .thread-narrow {
      display: block;
      height: 56px;
    }

    .thread-narrow path {
      stroke-width: 2.2;
    }

    .thread-labels {
      font-size: 11px;
    }
  }
</style>
