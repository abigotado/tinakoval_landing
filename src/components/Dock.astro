---
import { dock, price } from '../content/ru';

const base = import.meta.env.BASE_URL;
---

<div class="dock" data-dock>
  <p class="dock-price">
    {dock.label}
    <b>{price.amount}</b>
  </p>
  <a class="btn btn-primary dock-cta" href={`${base}#contact`}>
    {dock.cta}
  </a>
</div>

<script>
  // Phone booking bar (§5.14): hide it while the contact section is on
  // screen. Without JS it simply stays visible (AC-DOCK-2).
  const bar = document.querySelector<HTMLElement>('[data-dock]');
  const contact = document.getElementById('contact');

  if (bar && contact && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      const hidden = entry?.isIntersecting ?? false;
      bar.toggleAttribute('data-hidden', hidden);
      bar.toggleAttribute('inert', hidden);
    }).observe(contact);
  }
</script>

<style>
  .dock {
    display: none;
  }

  @media (max-width: 859px) {
    .dock {
      position: fixed;
      z-index: 10;
      right: 0;
      bottom: 0;
      left: 0;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
      border-top: 1px solid var(--line);
      background: rgb(244 242 241 / 0.96);
      transition:
        transform 0.25s ease,
        opacity 0.25s ease,
        visibility 0.25s;
    }

    .dock[data-hidden] {
      visibility: hidden;
      opacity: 0;
      transform: translateY(100%);
    }
  }

  .dock-price {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    line-height: 1.2;
    color: var(--muted);
  }

  .dock-price b {
    color: var(--ink);
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
  }

  .dock-cta {
    flex: 1;
    min-height: 52px;
    padding: 0 16px;
  }
</style>
