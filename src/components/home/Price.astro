---
import { price, pricing } from '../../content/ru';

const base = import.meta.env.BASE_URL;

type Props = Record<string, never>;
---

<section id="price" class="band" aria-labelledby="price-title">
  <div class="container price">
    <div>
      <h2 id="price-title" class="eyebrow">
        {pricing.eyebrow}
      </h2>
      <p class="price-amount">
        {price.rub}
        <span aria-hidden="true">/</span>
        <span class="visually-hidden">{` ${price.or} `}</span>
        {price.usd}
      </p>
      <ul class="price-details">
        {pricing.details.map((detail) => (
          <li>{detail}</li>
        ))}
      </ul>
    </div>
    <a class="btn btn-primary price-cta" href={`${base}#contact`}>
      {pricing.cta}
    </a>
  </div>
</section>

<style>
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 4rem;
    padding-block: 6.5rem;
  }

  .price-amount {
    margin-top: 1.125rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3.5rem, 6.4vw, 5.75rem);
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
    hyphens: manual;
  }

  .price-amount span[aria-hidden] {
    margin: 0 0.35em;
    font-size: 0.5em;
    color: var(--muted);
  }

  .price-details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.375rem;
    margin-top: 1.125rem;
    padding: 0;
    list-style: none;
    color: var(--muted);
  }

  @media (max-width: 53.7499em),
    (orientation: landscape) and (max-height: 31.25em) {
    .price {
      gap: 1.75rem 2rem;
      padding-block: 4rem;
    }

    .price-amount {
      margin-top: 1rem;
      font-size: min(3.125rem, 15.6vw);
      line-height: 1.1;
    }

    .price-details {
      gap: 0.25rem 1.125rem;
      margin-top: 0.875rem;
      font-size: 0.9375rem;
    }
  }

  @media (max-width: 37.4999em) and (orientation: portrait) {
    .price {
      flex-direction: column;
      align-items: stretch;
    }

    .price :global(.btn) {
      padding-inline: 1rem;
    }
  }
</style>
