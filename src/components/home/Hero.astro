---
import { Picture } from 'astro:assets';

import portrait from '../../assets/portrait.jpg';
import { hero, price } from '../../content/ru';
import Mark from '../Mark.astro';

const base = import.meta.env.BASE_URL;

type Props = Record<string, never>;
---

<section id="top" class="container hero">
  <div class="hero-text">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 class="hero-title">
      {`${hero.titleLine1} `}
      <br />
      {hero.titleLine2}
    </h1>
    <p class="hero-subtitle">{hero.subtitle}</p>
    <p class="hero-lead">{hero.lead}</p>
    <div class="hero-actions">
      <a class="btn btn-primary hero-cta" href={`${base}#contact`}>
        {hero.cta}
      </a>
      <p class="hero-price">
        {price.duration} · <b>{price.rub}</b> / <b>{price.usd}</b>
      </p>
    </div>
  </div>
  <div class="portrait">
    <Mark variant="column" class="hero-mark" />
    <Picture
      src={portrait}
      formats={['avif', 'webp']}
      widths={[200, 400, 600, 840]}
      sizes="(orientation: landscape) and (max-height: 500px) 280px, (max-width: 599px) 200px, (max-width: 859px) 280px, 420px"
      alt={hero.photoAlt}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 3rem 5.5rem;
    padding-block: 5.5rem 1rem;
  }

  .hero-text {
    flex: 1 1 32.5rem;
    min-width: 0;
  }

  .hero-title {
    margin-top: 1.375rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3.25rem, 6.4vw, 5.75rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
    hyphens: manual;
  }

  .hero-subtitle {
    margin-top: 1rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.25;
    color: var(--muted);
  }

  .hero-lead {
    max-width: 34em;
    margin-top: 1.875rem;
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.5rem;
    margin-top: 2.25rem;
  }

  .hero-price {
    color: var(--muted);
    font-size: 1rem;
  }

  .hero-price b {
    color: var(--ink);
    font-weight: 600;
  }

  .portrait {
    position: relative;
    flex: 0 1 26.25rem;
    min-width: 16.25rem;
    max-width: 100%;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    /* Not clipped, so the 花永愛 mark can sit outside; the photo clips itself. */
    border-radius: 22px;
  }

  .portrait :global(picture) {
    border-radius: inherit;
  }

  .portrait :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    object-position: 52% 28%;
  }

  /* 花永愛 beside the photo (AC-MARK-2). Out of the flow, so it never moves the
     layout; shown only where the gap between text and photo can hold it. */
  .portrait :global(.hero-mark) {
    display: none;
  }

  @media (width >= 71.875em) {
    .portrait :global(.hero-mark) {
      display: block;
      position: absolute;
      inset-inline-end: calc(100% + 1.75rem);
      bottom: 1rem;
      width: 2.5rem;
      height: 7.5rem;
    }
  }

  /* Narrow desktop: keep the photo beside the text. */
  @media (53.75em <= width < 71.875em) {
    .hero {
      gap: 3rem 2.5rem;
    }

    .hero-text {
      flex-basis: 22.5rem;
    }

    .portrait {
      flex-basis: 20rem;
    }
  }

  /* Tablet, phone and landscape phone. The photo stays beside the text until
     the phone layout below stacks them. Display sizes are capped in vw so a
     large system font still fits a narrow phone. */
  @media (width < 53.75em), (orientation: landscape) and (height <= 31.25em) {
    .hero {
      flex-wrap: nowrap;
      gap: 2rem;
      padding-block: 2rem 0.5rem;
    }

    .hero-text {
      flex: 1 1 0;
    }

    .portrait {
      flex: 0 0 clamp(12.5rem, 32vw, 17.5rem);
      min-width: 0;
      border-radius: 18px;
    }

    .hero-title {
      margin-top: 0.75rem;
      font-size: min(3rem, 15vw);
    }

    .hero-subtitle {
      margin-top: 0.625rem;
      font-size: 1.375rem;
    }

    .hero-lead {
      margin-top: 1.125rem;
      font-size: 1.0625rem;
    }

    .hero-actions {
      gap: 0.75rem 1.25rem;
      margin-top: 1.75rem;
    }

    .hero-price {
      font-size: 0.9375rem;
    }
  }

  /* Phone in portrait: photo above the text, full-width button. */
  @media (width < 37.5em) and (orientation: portrait) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: 1.5rem 0.5rem;
    }

    .hero-text {
      flex: none;
    }

    .portrait {
      order: -1;
      flex: none;
      width: min(12.5rem, 100%);
      margin-bottom: 1.5rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions :global(.btn) {
      padding-inline: 1rem;
    }

    .hero-price {
      text-align: center;
    }
  }

  /* Landscape phone: the photo fits between the header and the booking bar. */
  @media (orientation: landscape) and (height <= 31.25em) {
    .hero {
      align-items: flex-start;
      padding-top: 1.25rem;
    }

    .hero-title {
      font-size: min(2.25rem, 7vw);
    }

    .hero-subtitle {
      margin-top: 0.25rem;
    }

    .hero-lead {
      margin-top: 0.75rem;
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .hero-actions {
      margin-top: 1rem;
    }

    .portrait {
      flex: none;
      height: calc(100svh - var(--header-h) - var(--dock-h) - 3rem);
      max-height: 22rem;
      min-height: 10rem;
    }
  }
</style>
