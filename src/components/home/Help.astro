---
import { help } from '../../content/ru';

type Props = Record<string, never>;
---

<section id="help" class="band" aria-labelledby="help-title">
  <div class="container section">
    <p class="eyebrow">{help.eyebrow}</p>
    <h2 id="help-title" class="h2 help-title">
      {help.title}
    </h2>
    <ul class="help-list">
      {help.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .help-title {
    max-width: 16em;
  }

  .help-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 4rem;
    margin-top: 3.5rem;
    padding: 0;
    list-style: none;
  }

  .help-list li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.625rem 0 2rem;
    border-top: 1px solid var(--line-olive);
  }

  .help-list h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.875rem;
    line-height: 1.15;
  }

  .help-list p {
    max-width: 30em;
    color: var(--muted);
  }

  @media (max-width: 53.6875em),
    (orientation: landscape) and (max-height: 31.25em) {
    .help-list {
      margin-top: 2.25rem;
    }

    .help-list li {
      gap: 0.375rem;
      padding: 1.25rem 0 1.5rem;
    }

    .help-list h3 {
      font-size: 1.625rem;
    }
  }

  @media (max-width: 47.4375em) {
    .help-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
