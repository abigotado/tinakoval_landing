---
// The 花永愛 mark from the first version of the site (D-12): stroke paths
// in the KanjiVG style, drawn as thin plum lines. `yong` is the single 永 for
// the header; `column` is the vertical 花 · 永 · 愛 that the hero draws once,
// stroke by stroke (AC-MARK-2). Decorative: the name next to it says it all.
interface Props {
  variant: 'yong' | 'column';
  class?: string;
}

const { variant, class: className } = Astro.props;

const YONG = [
  'M45.5,13.25c5.12,2.4,8.62,5.75,10.75,9',
  'M31.75,37.25c1.88,0.75,4.12,1,6.07,0.55c3.62-0.83,9.41-2.51,13.04-3.35c3-0.7,5.16,0.8,5.16,4.05c0,14.5-0.26,45.45-0.26,50c0,12-7.02,2.84-8.52,1.7',
  'M14.25,58.68c1.75,0.45,3.46,0.3,5-0.02c2.5-0.53,12.84-3.54,15.34-4.49c2.5-0.95,4.65,0.77,3.75,2.85C33.5,68.25,25.75,79.75,16,86.37',
  'M81.22,36.52c-0.1,1.11-0.78,2.03-1.52,2.7c-4.83,4.38-13.96,9.73-21.46,11.92',
  'M58,52.74c9.88,9.52,20.02,18.85,29.07,24.84c2.01,1.33,4.05,2.66,6.43,3.56',
];

// 花 · 永 · 愛, top to bottom; each glyph sits in its own 109-unit square.
const COLUMN = [
  [
    'M17,29.77c3,0.73,6.35,0.54,9.37,0.29c16.22-1.35,36.31-4.64,56.76-4.79c2.4-0.02,4.77,0.04,7.12,0.51',
    'M32.25,16c1.25,0.5,2.25,1.62,2.5,2.75c1.33,5.97,4.86,19.92,5,20.75',
    'M71.25,12.5c0.42,1.18,0.47,3.05,0,4.5c-2.19,6.77-6.14,19.12-6.75,20.75',
    'M38.25,48.25c0.25,1.75-0.37,3.31-0.98,4.44C33.25,60,24.8,69.67,19.5,74.5',
    'M30.75,65.5c0.75,1,1.12,1.97,1.12,3c0,6.64-0.08,16.47-0.11,24c-0.01,1.96-0.01,3.82-0.01,5.5',
    'M84.25,50.25c-0.12,1.62-0.84,2.87-2,3.75c-4.62,3.5-11,6.75-19,9.75',
    'M58.25,43.75c1.06,1.06,1.5,2.5,1.5,4.75c0,2.96-0.22,20.59-0.22,31.25C59.53,93,63,94.15,77,94.15c16.25,0,18-2.65,18-11.15',
  ],
  [
    'M45.5,13.25c5.12,2.4,8.62,5.75,10.75,9',
    'M31.75,37.25c1.88,0.75,4.12,1,6.07,0.55c3.62-0.83,9.41-2.51,13.04-3.35c3-0.7,5.16,0.8,5.16,4.05c0,14.5-0.26,45.45-0.26,50c0,12-7.02,2.84-8.52,1.7',
    'M14.25,58.68c1.75,0.45,3.46,0.3,5-0.02c2.5-0.53,12.84-3.54,15.34-4.49c2.5-0.95,4.65,0.77,3.75,2.85C33.5,68.25,25.75,79.75,16,86.37',
    'M81.22,36.52c-0.1,1.11-0.78,2.03-1.52,2.7c-4.83,4.38-13.96,9.73-21.46,11.92',
    'M58,52.74c9.88,9.52,20.02,18.85,29.07,24.84c2.01,1.33,4.05,2.66,6.43,3.56',
  ],
  [
    'M59.38,8.75c-0.21,0.82-0.79,1.64-1.47,2.17c-3.13,2.42-12.8,6.29-23.36,8.97',
    'M32.12,23.38c3.07,1.58,7.54,5.46,8.31,7.92',
    'M48.17,22.31c2.68,1.28,6.93,5.28,7.6,7.28',
    'M75.86,18.37c0.12,0.96-0.09,1.34-0.68,2.14c-2.05,2.78-6.53,6.83-12.91,10.99',
    'M17.99,38.24c-0.1,3.62-1.86,11.86-2.72,14.08',
    'M18.36,39.68c18.14-1.93,48.77-6.31,68.68-7.1c13.73-0.55,3.22,6.92-0.68,9.26',
    'M29.53,46.89c0.19,1.49-1.93,8.08-3.47,10.57',
    'M39.78,45.13c6.35,9.25,13.6,13,34.98,12.1c5.32-0.22,5.31-2.72,2.4-4.63',
    'M53.13,42.75c1.49,3,4.72,5.55,5.58,3.13',
    'M72.97,40.61c3.28,2.14,5.4,3.51,8.03,7.55',
    'M41.78,60.53c0.11,1.11-0.05,2.08-0.47,3.12c-1.89,4.68-8.45,13.22-17.19,18.6',
    'M42.58,67.93c0.4,0.03,2.1,0.04,3.24-0.08c5.8-0.6,12.43-2.1,18.93-3.6c3.61-0.83,5.25,1,3.25,4.25c-4.94,8.02-25.58,27.16-48.5,31.22',
    'M39.1,73.3c8.4,1.32,25.91,14.1,36.4,19.82C78.94,95,82.46,96.47,86.38,97',
  ],
];

// One stroke every 0.16 s: the whole column takes about four seconds.
const STEP = 0.16;
const strokes = COLUMN.flatMap((glyph, row) => glyph.map((d) => ({ d, row })));
---

{variant === 'yong' ? (
  <svg
    class:list={['mark', className]}
    viewBox="8 6 94 94"
    aria-hidden="true"
    focusable="false"
  >
    {YONG.map((d) => (
      <path d={d} />
    ))}
  </svg>
) : (
  <svg
    class:list={['mark', 'mark-column', className]}
    viewBox="0 0 109 327"
    aria-hidden="true"
    focusable="false"
  >
    {strokes.map(({ d, row }, i) => (
      <path
        d={d}
        transform={`translate(0 ${row * 109})`}
        pathLength="1"
        style={`--delay: ${(i * STEP).toFixed(2)}s`}
      />
    ))}
  </svg>
)}

<style>
  .mark {
    display: block;
    fill: none;
    stroke: var(--plum);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mark:not(.mark-column) {
    stroke-width: 7;
  }

  .mark-column {
    stroke-width: 3.6;
  }

  /* Drawn once on load; with reduced motion the mark is simply there. */
  @media (prefers-reduced-motion: no-preference) {
    .mark-column path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: mark-draw 0.6s ease-out var(--delay) forwards;
    }
  }

  @keyframes mark-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
