---
import { contacts, nav, person } from '../content/ru';
import ExternalLink from './ExternalLink.astro';
import Mark from './Mark.astro';

const base = import.meta.env.BASE_URL;

type Props = Record<string, never>;
---

<a class="skip-link" href="#main">
  {nav.skip}
</a>
<header class="header" data-header>
  <div class="container header-inner">
    <a class="brand" href={`${base}#top`}>
      <Mark variant="yong" class="brand-mark" />
      <span class="brand-text">
        <span class="brand-name">{person.name}</span>
        <span class="brand-role">{person.profession}</span>
      </span>
    </a>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-button
      data-label-open={nav.menuOpen}
      data-label-close={nav.menuClose}
    >
      {nav.menuOpen}
    </button>
    <nav id="site-nav" class="nav" aria-label={nav.label} data-menu>
      <ul class="nav-list">
        {nav.items.map((item) => (
          <li>
            <a href={`${base}${item.href}`}>{item.label}</a>
          </li>
        ))}
      </ul>
      <ExternalLink class="nav-contact" href={contacts.telegram.href}>
        {contacts.telegram.label} · {contacts.telegram.handle}
      </ExternalLink>
    </nav>
    <a class="btn btn-primary header-cta" href={`${base}#contact`}>
      {nav.cta}
    </a>
  </div>
</header>

<script>
  // Phone menu (AC-HEADER-2): toggles on the button, closes on Esc and after
  // a link is chosen, and returns focus to the button.
  const button =
    document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (header) {
    // The header grows with a larger system font; keep scroll offsets and the
    // phone menu in step with its real height (CSS values are the fallback).
    new ResizeObserver(() => {
      document.documentElement.style.setProperty(
        '--header-h',
        `${header.offsetHeight}px`,
      );
    }).observe(header, { box: 'border-box' });
  }

  if (button && menu && header) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open
        ? (button.dataset.labelClose ?? '')
        : (button.dataset.labelOpen ?? '');
      menu.toggleAttribute('data-open', open);
      if (!open && restoreFocus) button.focus({ preventScroll: true });
    };

    button.addEventListener('click', () =>
      setOpen(button.getAttribute('aria-expanded') !== 'true'),
    );
    menu.addEventListener('click', (event) => {
      const link = (event.target as Element).closest('a');
      if (!link || !menu.hasAttribute('data-open')) return;
      setOpen(false, true);
      // A same-page anchor would move focus away from the button, so scroll
      // to it here instead (CSS scroll-behavior keeps it smooth).
      const target =
        link.pathname === location.pathname && link.hash
          ? document.getElementById(link.hash.slice(1))
          : null;
      if (!target) return;
      event.preventDefault();
      history.pushState(null, '', link.hash);
      target.scrollIntoView();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.hasAttribute('data-open')) {
        setOpen(false, true);
      }
    });
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !header.contains(next)) setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 1.125rem;
  }

  .brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    line-height: 1.1;
    text-decoration: none;
    hyphens: manual;
  }

  .brand :global(.brand-mark) {
    flex: none;
    width: 2.125rem;
    height: 2.125rem;
  }

  .brand-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--serif);
    font-size: 1.4375rem;
  }

  .brand-role {
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .menu-button {
    display: none;
  }

  .nav {
    margin-inline-start: auto;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: none;
    hyphens: manual;
  }

  @media (hover: hover) {
    .nav-list a:hover {
      color: var(--plum);
    }
  }

  .nav-contact {
    display: none;
  }

  .header-cta {
    min-height: 2.75rem;
    padding: 0 1.375rem;
    font-size: 0.9375rem;
  }

  /* Too narrow for one row: the nav gets its own row under name and button. */
  @media (min-width: 53.75em) and (max-width: 71.8125em) {
    .header-inner {
      flex-wrap: wrap;
      gap: 0 1.5rem;
      padding-block: 0.875rem 0.25rem;
    }

    .nav {
      order: 3;
      flex-basis: 100%;
      margin-inline-start: 0;
    }

    .header-cta {
      margin-inline-start: auto;
    }
  }

  @media (max-width: 53.6875em),
    (orientation: landscape) and (max-height: 31.25em) {
    .header-inner {
      justify-content: space-between;
      gap: 0.75rem;
      padding-block: 0.875rem;
    }

    .brand-name {
      font-size: min(1.25rem, 6.25vw);
    }

    .brand-role {
      font-size: 0.625rem;
    }

    .menu-button {
      display: inline-flex;
      align-items: center;
      min-width: 2.75rem;
      height: 2.75rem;
      padding: 0 1rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: 0.9375rem;
      cursor: pointer;
    }

    .header-cta {
      display: none;
    }

    .nav {
      display: none;
      position: fixed;
      z-index: 30;
      inset: var(--header-h) 0 0;
      flex-direction: column;
      margin: 0;
      padding: 0.5rem max(var(--gutter), env(safe-area-inset-right, 0px))
        calc(1.5rem + env(safe-area-inset-bottom, 0px))
        max(var(--gutter), env(safe-area-inset-left, 0px));
      overflow-y: auto;
      background: var(--paper);
    }

    .nav[data-open] {
      display: flex;
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
    }

    .nav-list a {
      display: flex;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--line);
      font-family: var(--serif);
      font-size: 1.625rem;
      line-height: 1.3;
      color: var(--ink);
    }

    .nav-contact {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      min-height: 2.75rem;
      margin-top: auto;
      padding-top: 1.5rem;
      color: var(--muted);
      font-size: 0.9375rem;
      text-decoration: none;
    }
  }

  /* Very short screen with a large system font: the header scrolls away
     instead of covering most of the page, and the menu opens below it. */
  @media (max-height: 19.9375em) {
    .header {
      position: relative;
    }

    .nav {
      position: absolute;
      inset: 100% 0 auto;
    }
  }
</style>
