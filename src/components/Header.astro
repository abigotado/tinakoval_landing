---
import { contacts, nav, person } from '../content/ru';
import ExternalLink from './ExternalLink.astro';

const base = import.meta.env.BASE_URL;
---

<a class="skip-link" href="#main">
  {nav.skip}
</a>
<header class="header" data-header>
  <div class="container header-inner">
    <a class="brand" href={`${base}#top`}>
      <span class="brand-name">{person.name}</span>
      <span class="brand-role">{person.profession}</span>
    </a>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-button
      data-label-open={nav.menuOpen}
      data-label-close={nav.menuClose}
    >
      {nav.menuOpen}
    </button>
    <nav id="site-nav" class="nav" aria-label={nav.label} data-menu>
      <ul class="nav-list">
        {nav.items.map((item) => (
          <li>
            <a href={`${base}${item.href}`}>{item.label}</a>
          </li>
        ))}
      </ul>
      <ExternalLink class="nav-contact" href={contacts.telegram.href}>
        {contacts.telegram.label} · {contacts.telegram.handle}
      </ExternalLink>
    </nav>
    <a class="btn btn-primary header-cta" href={`${base}#contact`}>
      {nav.cta}
    </a>
  </div>
</header>

<script>
  // Phone menu (AC-HEADER-2): toggles on the button, closes on Esc and after
  // a link is chosen, and returns focus to the button.
  const button =
    document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (button && menu && header) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open
        ? (button.dataset.labelClose ?? '')
        : (button.dataset.labelOpen ?? '');
      menu.toggleAttribute('data-open', open);
      if (!open && restoreFocus) button.focus({ preventScroll: true });
    };

    button.addEventListener('click', () =>
      setOpen(button.getAttribute('aria-expanded') !== 'true'),
    );
    menu.addEventListener('click', (event) => {
      const link = (event.target as Element).closest('a');
      if (!link || !menu.hasAttribute('data-open')) return;
      setOpen(false, true);
      // A same-page anchor would move focus away from the button, so scroll
      // to it here instead (CSS scroll-behavior keeps it smooth).
      const target =
        link.pathname === location.pathname && link.hash
          ? document.getElementById(link.hash.slice(1))
          : null;
      if (!target) return;
      event.preventDefault();
      history.pushState(null, '', link.hash);
      target.scrollIntoView();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.hasAttribute('data-open')) {
        setOpen(false, true);
      }
    });
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !header.contains(next)) setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 16px 32px;
    padding-block: 18px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    line-height: 1.1;
    text-decoration: none;
    hyphens: manual;
  }

  .brand-name {
    font-family: var(--serif);
    font-size: 23px;
  }

  .brand-role {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .menu-button {
    display: none;
  }

  .nav {
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
    hyphens: manual;
  }

  @media (hover: hover) {
    .nav-list a:hover {
      color: var(--plum);
    }
  }

  .nav-contact {
    display: none;
  }

  .header-cta {
    min-height: 44px;
    padding: 0 22px;
    font-size: 15px;
  }

  /* Too narrow for one row: the nav gets its own row under name and button. */
  @media (max-width: 1149px) and (min-width: 860px) {
    .header-inner {
      flex-wrap: wrap;
      gap: 0 24px;
      padding-block: 14px 4px;
    }

    .nav {
      order: 3;
      flex-basis: 100%;
      margin-left: 0;
    }

    .header-cta {
      margin-left: auto;
    }
  }

  @media (max-width: 859px) {
    .header-inner {
      justify-content: space-between;
      gap: 12px;
      padding-block: 14px;
    }

    .brand-name {
      font-size: 20px;
    }

    .brand-role {
      font-size: 10px;
    }

    .menu-button {
      display: inline-flex;
      align-items: center;
      min-width: 44px;
      height: 44px;
      padding: 0 16px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: 15px;
      cursor: pointer;
    }

    .header-cta {
      display: none;
    }

    .nav {
      display: none;
      position: fixed;
      z-index: 30;
      inset: var(--header-h) 0 0;
      flex-direction: column;
      margin: 0;
      padding: 8px var(--gutter) calc(24px + env(safe-area-inset-bottom, 0px));
      overflow-y: auto;
      background: var(--paper);
    }

    .nav[data-open] {
      display: flex;
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
    }

    .nav-list a {
      display: flex;
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
      font-family: var(--serif);
      font-size: 26px;
      line-height: 1.3;
      color: var(--ink);
    }

    .nav-contact {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 44px;
      margin-top: auto;
      padding-top: 24px;
      color: var(--muted);
      font-size: 15px;
      text-decoration: none;
    }
  }
</style>
