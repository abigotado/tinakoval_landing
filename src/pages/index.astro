---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';

import portrait from '../assets/portrait.jpg';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import About from '../components/home/About.astro';
import Contact from '../components/home/Contact.astro';
import Education from '../components/home/Education.astro';
import Familiar from '../components/home/Familiar.astro';
import Help from '../components/home/Help.astro';
import Hero from '../components/home/Hero.astro';
import Materials from '../components/home/Materials.astro';
import Price from '../components/home/Price.astro';
import Steps from '../components/home/Steps.astro';
import Thread from '../components/Thread.astro';
import { contacts, meta, person, price, schema } from '../content/ru';

const base = import.meta.env.BASE_URL;
const siteUrl = new URL(base, Astro.site).href;
const photo = await getImage({ src: portrait, width: 600, format: 'jpg' });
const photoUrl = new URL(photo.src, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: person.name,
      jobTitle: schema.jobTitle,
      image: photoUrl,
      url: siteUrl,
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: schema.university,
      },
      sameAs: [contacts.telegram.href],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}#service`,
      name: meta.title,
      description: meta.description,
      url: siteUrl,
      image: photoUrl,
      founder: { '@id': `${siteUrl}#person` },
      areaServed: schema.areaServed,
      availableLanguage: 'ru',
      priceRange: price.amount,
      makesOffer: [
        { currency: 'RUB', amount: price.rubValue },
        { currency: 'USD', amount: price.usdValue },
      ].map(({ currency, amount }) => ({
        '@type': 'Offer',
        price: amount,
        priceCurrency: currency,
        itemOffered: { '@type': 'Service', name: schema.service },
      })),
      sameAs: [contacts.telegram.href],
    },
  ],
};
---

<Base title={meta.title} description={meta.description}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <Header />

  <main id="main">
    <Hero />
    <Thread />
    <Familiar />
    <Help />
    <About />
    <Steps />
    <Price />
    <Materials />
    <Contact />
    <Education />
  </main>

  <Footer withDock />
  <Dock />
</Base>
